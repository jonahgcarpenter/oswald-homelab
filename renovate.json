{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["flux", "kubernetes", "regex"],
  "flux": {
    "managerFilePatterns": ["/clusters/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/clusters/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "matchDatasources": ["helm"],
      "groupName": "helm-charts",
      "assignees": ["jonahgcarpenter"]
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "docker-images",
      "assignees": ["jonahgcarpenter"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/siderolabs/talos", "ghcr.io/siderolabs/kubelet"],
      "groupName": "talos-k8s",
      "assignees": ["jonahgcarpenter"]
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["clusters/production/tuppr/.+\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*version:\\s*(?<currentValue>\\S+)"
      ]
    }
  ]
}
